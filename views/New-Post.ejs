<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/post-form.css">
  <title>Upload a new post</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Manrope:wght@200..800&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="\images\meteor-solid-full.svg">
</head>

<body>
  <%- include("partials/header.ejs") %>
  <main>
  <h2 class="heading">Upload a blog</h2>
  <form class="container" action="/newPost" method="post">
    <label for="title">Title:</label>
    <input type="text" id="title" name="title" placeholder="Enter blog title..." required>
    <label for="summary">Summary:</label>
    <textarea name="summary" id="summary" placeholder="Enter blog summary..." required></textarea>
    <label for="content">Content:</label>
    <textarea name="content" id="content" placeholder="Enter blog content..." required></textarea>
    <input class="primary-button" type="submit" value="Post">
  </form>
  </main>

  <%- include("partials/footer.ejs") %>

</body>

</html>